      "id": "2fbd77c5-6d38-4243-ad6e-0fc897154786",
      "name": "delivery",
      "description": {
        "content": "Operations for managing the delivery lifecycle. Use these endpoints to trigger a shipment, cancel an active delivery, or check whether a pickup location falls within an operating area.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f720a97c-20e1-4395-8cca-4edb3a0d189a",
          "name": "Cancel the delivery of the specified parcels.",
          "request": {
            "name": "Cancel the delivery of the specified parcels.",
            "description": {
              "content": "Cancels an in-progress delivery for the given parcels, when cancellation is still permitted. Delivery cannot be cancelled once the parcel has been picked up. Cancellation is allowed in the following states: `qualifiedforpickup`, `onroutetopickup`, and `pickingup`. Please note that cancellation may incur costs.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "parcels",
                "deliver",
                "cancel"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parcel_ids\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ]\n}",
