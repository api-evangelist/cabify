        {
          "id": "dadfa229-2770-4eb0-a50d-5675d247405b",
          "name": "Check whether a pickup location is within an operating area.",
          "request": {
            "name": "Check whether a pickup location is within an operating area.",
            "description": {
              "content": "Verifies that the given pickup location is covered by the delivery service. You can provide either a text address (`address`) or geographic coordinates (`pickup_point`).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "parcels",
                "deliver",
                "pickup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "Full address to check (e.g. `Calle Pradillo 42, Madrid`). You must provide either `address` or `pickup_point` (or both).\n"
                },
                {
                  "disabled": false,
                  "key": "pickup_point",
                  "value": "<string>",
                  "description": "Geographic coordinates of the pickup location, formatted as `latitude,longitude`. You must provide either `address` or `pickup_point` (or both).\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "5c43b468-9a7a-4646-929a-677306abb30b",
              "name": "The pickup location is within an operating area.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "parcels",
                    "deliver",
                    "pickup"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "address",
                      "value": "Calle%20Pradillo%2042%2C%20Madrid (Calle Pradillo 42, Madrid)"
                    },
                    {
                      "key": "pickup_point",
                      "value": "40.456367,-3.690587"
                    }
                  ],
                  "variable": []
                },
                "header": [
