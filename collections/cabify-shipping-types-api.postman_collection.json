          "name": "List available shipping types for a location.",
          "request": {
            "name": "List available shipping types for a location.",
            "description": {
              "content": "Returns the shipping types available to your account for a given pickup location. The available options are determined by your account configuration and the geographic region of the provided coordinates.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "shipping_types",
                "available"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "(Required) Geographic coordinates of the pickup point, formatted as `latitude,longitude`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
